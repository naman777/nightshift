# Non-secret runtime settings for `python -m onboard.watch` on the EC2 host profile. Secrets (OPENAI_API_KEY) stay in ../../.env.
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
LOKI_PLAIN_TEXT=1
NIGHTSHIFT_BACKEND=live
NIGHTSHIFT_CATALOGUE=/home/ubuntu/nightshift-run/host/catalogue.json
NIGHTSHIFT_SERVICE_MAP=/home/ubuntu/nightshift-run/host/service_map.json
CONFIG_REPO=/home/ubuntu/Load-Balancer-CPP
NIGHTSHIFT_CONFIG_REPOS='{"lb":"/home/ubuntu/Load-Balancer-CPP","lb-sandbox":"/home/ubuntu/nightshift-run/sandbox-config"}'
DEPLOY_LOG=/home/ubuntu/nightshift-run/deploys.jsonl
CODE_ROOT=/home/ubuntu/Load-Balancer-CPP
NIGHTSHIFT_RUNTIME=systemd
NIGHTSHIFT_SYSTEMD_UNITS='{"lb":"lb.service","lb-sandbox":"nsbox-lb.service"}'
NIGHTSHIFT_DB_URL=sqlite:////home/ubuntu/nightshift-run/nightshift.db
NIGHTSHIFT_REPORTS=/home/ubuntu/nightshift-run/reports
NIGHTSHIFT_INCIDENT_BUDGET_USD=1.0
NIGHTSHIFT_MEMORY=0
