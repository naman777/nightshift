diff --git a/load-balancer/metrics.h b/load-balancer/metrics.h
new file mode 100644
index 0000000..e5b9f4f
--- /dev/null
+++ b/load-balancer/metrics.h
@@ -0,0 +1,108 @@
+#pragma once
+// Prometheus text-format metrics for the load balancer (no external library).
+//
+// Exposed at GET /metrics on the stats port (listen_port + 1):
+//   http_requests_total{path,status}          requests proxied, by first path segment and upstream status (502/504 are LB-generated)
+//   http_request_duration_seconds_*           end-to-end latency histogram (accept -> connection closed)
+//   upstream_healthy                          number of healthy upstreams
+//   upstream_up{upstream}, upstream_active_connections{upstream}
+//   process_resident_memory_bytes, process_cpu_seconds_total, process_start_time_seconds, log_lines_total
+#include "logger.h"
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <sys/resource.h>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+class Metrics {
+public:
+    static constexpr std::array<double, 11> kBuckets = {0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0};
+
+    Metrics() : start_time_(static_cast<double>(std::time(nullptr))) {}
+
+    // First path segment only ("/orders/42?x=1" -> "/orders"), capped at 16 distinct values to bound cardinality.
+    static std::string path_label(const std::string& request_head) {
+        auto sp1 = request_head.find(' ');
+        if (sp1 == std::string::npos) return "other";
+        auto sp2 = request_head.find(' ', sp1 + 1);
+        std::string target = request_head.substr(sp1 + 1, sp2 == std::string::npos ? std::string::npos : sp2 - sp1 - 1);
+        target = target.substr(0, target.find_first_of("?#"));
+        if (target.empty() || target[0] != '/') return "other";
+        auto slash = target.find('/', 1);
+        return slash == std::string::npos ? target : target.substr(0, slash);
+    }
+
+    void observe(const std::string& path, int status, double seconds) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        std::string p = path;
+        if (!paths_.count(p)) {
+            if (paths_.size() >= 16) p = "other";
+            else paths_[p] = true;
+        }
+        requests_[{p, status}]++;
+        for (size_t i = 0; i < kBuckets.size(); ++i)
+            if (seconds <= kBuckets[i]) buckets_[i]++;
+        count_++;
+        sum_ += seconds;
+    }
+
+    // `upstreams`: (name, healthy, active_connections)
+    struct Upstream { std::string name; bool healthy; int active; };
+
+    std::string render(const std::vector<Upstream>& upstreams) const {
+        std::ostringstream o;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            o << "# HELP http_requests_total Requests proxied by the load balancer.\n# TYPE http_requests_total counter\n";
+            for (const auto& [k, v] : requests_)
+                o << "http_requests_total{path=\"" << k.first << "\",status=\"" << k.second << "\"} " << v << "\n";
+            o << "# HELP http_request_duration_seconds Request latency, accept to close.\n# TYPE http_request_duration_seconds histogram\n";
+            for (size_t i = 0; i < kBuckets.size(); ++i)
+                o << "http_request_duration_seconds_bucket{le=\"" << kBuckets[i] << "\"} " << buckets_[i] << "\n";
+            o << "http_request_duration_seconds_bucket{le=\"+Inf\"} " << count_ << "\n"
+              << "http_request_duration_seconds_sum " << sum_ << "\n"
+              << "http_request_duration_seconds_count " << count_ << "\n";
+        }
+        int healthy = 0;
+        for (const auto& u : upstreams) healthy += u.healthy ? 1 : 0;
+        o << "# TYPE upstream_healthy gauge\nupstream_healthy " << healthy << "\n";
+        o << "# TYPE upstream_up gauge\n";
+        for (const auto& u : upstreams) o << "upstream_up{upstream=\"" << u.name << "\"} " << (u.healthy ? 1 : 0) << "\n";
+        o << "# TYPE upstream_active_connections gauge\n";
+        for (const auto& u : upstreams) o << "upstream_active_connections{upstream=\"" << u.name << "\"} " << u.active << "\n";
+        o << "# TYPE process_resident_memory_bytes gauge\nprocess_resident_memory_bytes " << resident_bytes() << "\n"
+          << "# TYPE process_cpu_seconds_total counter\nprocess_cpu_seconds_total " << cpu_seconds() << "\n"
+          << "# TYPE process_start_time_seconds gauge\nprocess_start_time_seconds " << start_time_ << "\n"
+          << "# TYPE log_lines_total counter\nlog_lines_total " << log_line_counter().load() << "\n";
+        return o.str();
+    }
+
+private:
+    static double resident_bytes() {
+        std::ifstream f("/proc/self/statm");
+        long size = 0, rss = 0;
+        if (f >> size >> rss) return static_cast<double>(rss) * static_cast<double>(sysconf(_SC_PAGESIZE));
+        return 0;
+    }
+    static double cpu_seconds() {
+        rusage ru{};
+        getrusage(RUSAGE_SELF, &ru);
+        return static_cast<double>(ru.ru_utime.tv_sec + ru.ru_stime.tv_sec) +
+               static_cast<double>(ru.ru_utime.tv_usec + ru.ru_stime.tv_usec) / 1e6;
+    }
+
+    mutable std::mutex mutex_;
+    std::map<std::pair<std::string, int>, unsigned long long> requests_;
+    std::map<std::string, bool> paths_;
+    std::array<unsigned long long, kBuckets.size()> buckets_{};
+    unsigned long long count_ = 0;
+    double sum_ = 0;
+    double start_time_;
+};
