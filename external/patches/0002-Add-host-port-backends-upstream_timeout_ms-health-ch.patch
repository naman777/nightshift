+// Parses "host:port,host:port,port" into parallel host/port vectors ("" host = 127.0.0.1).
+inline void parse_backends(const std::string& s, std::vector<int>& ports, std::vector<std::string>& hosts) {
+    ports.clear();
+    hosts.clear();
+    std::stringstream ss(s);
+    std::string tok;
+    while (std::getline(ss, tok, ',')) {
+        auto not_space = [](unsigned char c) { return !std::isspace(c); };
+        tok.erase(tok.begin(), std::find_if(tok.begin(), tok.end(), not_space));
+        tok.erase(std::find_if(tok.rbegin(), tok.rend(), not_space).base(), tok.end());
+        if (tok.empty()) continue;
+        auto colon = tok.rfind(':');
+        if (colon == std::string::npos) {
+            hosts.push_back("");
+            ports.push_back(std::stoi(tok));
+        } else {
+            hosts.push_back(tok.substr(0, colon));
+            ports.push_back(std::stoi(tok.substr(colon + 1)));
+        }
+    }
+}
+
+// Weights for `n` backends: explicit `weights` win, otherwise upstream_weight_orders_<i> keys (default 1).
+inline std::vector<int> effective_weights(const LBConfig& c, size_t n) {
+    if (!c.weights.empty()) return c.weights;
+    if (c.weights_by_index.empty()) return {};
+    std::vector<int> w(n, 1);
+    for (const auto& [idx, val] : c.weights_by_index)
+        if (idx >= 1 && static_cast<size_t>(idx) <= n && val > 0) w[idx - 1] = val;
+    return w;
+}
