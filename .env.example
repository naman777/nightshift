# LLM providers (leave empty to use the deterministic mock provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NIGHTSHIFT_COMMANDER_MODEL=claude-opus-4-5
NIGHTSHIFT_SPECIALIST_MODEL=claude-haiku-4-5
NIGHTSHIFT_LLM_PROVIDER=mock        # mock | anthropic | openai

# Storage
NIGHTSHIFT_DB_URL=sqlite:///nightshift.db   # or postgresql://nightshift:nightshift@localhost:5432/nightshift

# Safety
NIGHTSHIFT_DRY_RUN=1                # kill switch: every write tool becomes a dry run
NIGHTSHIFT_INCIDENT_BUDGET_USD=1.00

# Temporal / Slack
TEMPORAL_ADDRESS=localhost:7233
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#incidents
